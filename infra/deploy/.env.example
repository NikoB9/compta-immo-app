# Copy this file to infra/deploy/.env, replace every placeholder, then chmod 600.
# Use URL-safe hex passwords: openssl rand -hex 32
POSTGRES_DB=compta
POSTGRES_ADMIN_USER=compta_admin
POSTGRES_ADMIN_PASSWORD=replace-with-64-hex-characters
DATABASE_URL=postgresql://compta_app:replace-with-64-hex-characters@database:5432/compta
MIGRATION_DATABASE_URL=postgresql://compta_admin:replace-with-64-hex-characters@database:5432/compta

# Cloudflare Access application for this exact public hostname.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-the-application-audience-tag
APP_BASE_URL=https://compta.example.fr
INITIAL_OWNER_EMAIL=owner@example.com
