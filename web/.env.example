# Cloudflare Access application configuration (not secrets).
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-the-application-audience-tag
APP_BASE_URL=https://compta.example.fr
DATABASE_URL=postgresql://app_login:replace-me@localhost:5432/compta
PRIVATE_DOCUMENTS_DIR=/var/lib/compta-immo/documents

# Local-only UI development. This is ignored outside NODE_ENV=development.
CLOUDFLARE_ACCESS_BYPASS_LOCAL=true
